# Copy this file to .env.local for local development.
# On Netlify, add each of these under Site configuration → Environment variables.

# The public address of the site, no trailing slash.
SITE_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… while testing.
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. Dashboard → Settings → Billing → Customer portal → "Login link".
# Donors use it to change or cancel a monthly gift.
STRIPE_PORTAL_LOGIN_URL=

# ── Admin panel ───────────────────────────────────────────
# Comma-separated list of the email addresses allowed to log in.
ADMIN_EMAILS=jane@example.org,sam@example.org
# A long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# ── Email (magic links and admin alerts) via Resend ───────
# resend.com → API Keys. Without it, in local dev the login link prints in the terminal.
RESEND_API_KEY=
# Must be on a domain you have verified in Resend.
EMAIL_FROM="Community Centre <no-reply@yourdomain.org>"

# ── Content storage ───────────────────────────────────────
# Nothing to set on Netlify: content and photos are saved in Netlify Blobs automatically.
# Locally, content is saved to data/content.json and photos to public/uploads.
# Only if you self-host somewhere other than Netlify, set this to save to local files:
# ALLOW_LOCAL_STORAGE=1
